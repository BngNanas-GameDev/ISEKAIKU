# Contoh konfigurasi rahasia. Salin jadi `.env` lalu isi nilainya.
# `.env` diabaikan git — jangan pernah commit nilai asli.
#
# Script `scripts/flutter-env.ps1` membaca berkas ini dan meneruskannya
# sebagai --dart-define ke Flutter.

# Supabase → Settings → API
URL=
ANON_KEY=

# Google OAuth client ID yang dipakai aplikasi (tipe Web/Android)
ISEKAIKU_CID=

# Client ID & secret Google yang dipasang di Supabase (Providers → Google).
# Hanya untuk referensi/dashboard; tidak dipakai aplikasi.
SUPABASE_CID=
SUPABASE_CS=

